{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@fairgarden-private/design/components/*": [
        "../src/components/*"
      ],
      "@fairgarden-private/design/utils/*": [
        "../src/utils/*"
      ],
      "@fairgarden-private/design/icons/*": [
        "../src/icons/*"
      ],
      "@fairgarden-private/design/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-fix1/types/**/*.ts",
    ".next-fix1/dev/types/**/*.ts",
    ".next-fix2/types/**/*.ts",
    ".next-fix2/dev/types/**/*.ts",
    ".next-fix3/types/**/*.ts",
    ".next-fix3/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
